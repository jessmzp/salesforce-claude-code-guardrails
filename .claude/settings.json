{
  "permissions": {
    "allow": [
      "Bash(sf project retrieve start:*)",
      "Bash(sf apex run test:*)",
      "Bash(sf project deploy validate:*)",
      "Bash(sf org display:*)"
    ],
    "ask": ["Bash(sf project deploy start:*)"],
    "deny": [
      "Bash(sf org login:*)",
      "Bash(rm -rf:*)",
      "Read(./.sf/**)",
      "Read(./.sfdx/**)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-deploy.sh"
          }
        ]
      }
    ]
  }
}
