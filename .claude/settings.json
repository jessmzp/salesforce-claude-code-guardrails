{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(sf project retrieve start:*)",
      "Bash(sf apex run test:*)",
      "Bash(sf project deploy validate:*)",
      "Bash(sf org display:*)",
      "Bash(sf data query:*)"
    ],
    "ask": [
      "Bash(sf project deploy start:*)",
      "Bash(sf project deploy quick:*)",
      "Bash(sf project deploy resume:*)",
      "Bash(sf deploy metadata:*)",
      "Bash(sfdx force:source:deploy:*)",
      "Bash(sfdx force:mdapi:deploy:*)",
      "Bash(sf data import:*)",
      "Bash(sf data upsert:*)",
      "Bash(sf data update:*)",
      "Bash(sf data delete:*)",
      "Bash(sf data create:*)"
    ],
    "deny": [
      "Bash(sf org login:*)",
      "Bash(rm -rf:*)",
      "Read(./.sf/**)",
      "Read(./.sfdx/**)",
      "Read(./.env)",
      "mcp__salesforce-dx__resume_tool_operation"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-deploy.sh"
          }
        ]
      }
    ]
  }
}
